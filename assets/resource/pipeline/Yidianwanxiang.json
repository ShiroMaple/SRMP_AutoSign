{
    "MIXC": {
        "next": [
            "MIXC-confirmApp",
            {
                "jump_back": true,
                "name": "MIXC-closePopWindow"
            },
            {
                "jump_back": true,
                "name": "startMIXC"
            }
        ]
    },
    "MIXC-closePopWindow": {
        "action": {
            "param": {},
            "type": "Click"
        },
        "recognition": {
            "param": {
                "green_mask": true,
                "roi": [
                    273,
                    1081,
                    171,
                    171
                ],
                "template": "MIXC/buttonClose.png"
            },
            "type": "TemplateMatch"
        }
    },
    "MIXC-confirmApp": {
        "next": [
            "MIXC-enterStarPage",
            {
                "jump_back": true,
                "name": "MIXC-closePopWindow"
            }
        ],
        "recognition": {
            "param": {
                "expected": ".*万象.*"
            },
            "type": "OCR"
        }
    },
    "MIXC-enterSignPage": {
        "action": {
            "param": {},
            "type": "Click"
        },
        "next": [
            "MIXC-sign",
            "MIXC-enterSignPage"
        ],
        "recognition": {
            "param": {
                "roi": [
                    551,
                    28,
                    169,
                    167
                ],
                "template": "MIXC/entranceSignPage.png"
            },
            "type": "TemplateMatch"
        }
    },
    "MIXC-enterStarPage": {
        "action": {
            "param": {},
            "type": "Click"
        },
        "next": [
            "MIXC-enterSignPage",
            "MIXC-enterStarPage",
            {
                "jump_back": true,
                "name": "fullScreen_swipeBack"
            }
        ],
        "post_wait_freezes": 100,
        "recognition": {
            "param": {
                "expected": [
                    "签到得万象星",
                    "我的"
                ],
                "roi": [
                    374,
                    831,
                    346,
                    770
                ]
            },
            "type": "OCR"
        }
    },
    "MIXC-openBox": {
        "action": {
            "param": {},
            "type": "Click"
        },
        "next": [
            "stopMIXC"
        ],
        "post_wait_freezes": 1500,
        "recognition": {
            "param": {
                "expected": "立即打开",
                "roi": [
                    206,
                    977,
                    297,
                    183
                ]
            },
            "type": "OCR"
        }
    },
    "MIXC-result_signSucceed": {
        "focus": {
            "Node.Recognition.Succeeded": "{name}签到成功"
        },
        "next": [
            "MIXC-openBox"
        ],
        "on_error": [
            "fullScreen_swipeUp"
        ],
        "post_delay": 0,
        "recognition": {
            "param": {
                "template": "MIXC/TodaySigned.png",
                "threshold": [
                    0.85
                ]
            },
            "type": "TemplateMatch"
        },
        "timeout": 5000
    },
    "MIXC-sign": {
        "action": {
            "param": {},
            "type": "Click"
        },
        "next": [
            "MIXC-result_signSucceed"
        ],
        "post_wait_freezes": 500,
        "recognition": {
            "param": {
                "roi": [
                    250,
                    296,
                    220,
                    921
                ],
                "template": "MIXC/buttonSign.png"
            },
            "type": "TemplateMatch"
        }
    },
    "startMIXC": {
        "action": {
            "param": {
                "package": "com.crland.mixc"
            },
            "type": "StartApp"
        }
    },
    "stopMIXC": {
        "action": {
            "param": {
                "package": "com.crland.mixc"
            },
            "type": "StopApp"
        }
    }
}