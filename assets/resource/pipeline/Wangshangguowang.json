    "Wsgw-checkSignPage": {
        "next": [
            "Wsgw-checkWeekAwards",
            {
                "jump_back": true,
                "name": "Wsgw-clickReceive"
            }
        ],
        "on_error": [
            "fullScreen_swipeUp"
        ],
        "recognition": {
            "param": {
                "expected": "每日签到",
                "roi": [
                    226,
                    72,
                    272,
                    72
                ]
            },
            "type": "OCR"
        },
        "timeout": 5000
    },
    "Wsgw-checkWeekAwards": {
        "action": {
            "param": {
                "target_offset": [
                    0,
                    70,
                    0,
                    0
                ]
            },
            "type": "Click"
        },
        "next": [
            "Wsgw-无周礼包",
            "Wsgw-result_GetWeekAward",
            {
                "jump_back": true,
                "name": "Wsgw-clickReceive"
            }
        ],
        "on_error": [
            "Wsgw-result_NoWeekAward"
        ],
        "post_delay": 3000,
        "recognition": {
            "param": {
                "template": "Wsgw/buttonWeekAward1.png",
                "threshold": 0.8
            },
            "type": "TemplateMatch"
        },
        "timeout": 8000
    },
