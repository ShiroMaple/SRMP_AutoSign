{
    "Atour": {
        "next": [
            "Atour-confirmApp",
            {
                "jump_back": true,
                "name": "startAtour"
            }
        ]
    },
    "Atour-confirmApp": {
        "next": [
            "Atour-drawedCard",
            "Atour-signed",
            "Atour-drawCard",
            "Atour-sign",
            "Atour-enterSignPage",
            {
                "jump_back": true,
                "name": "Atour-enterMainPage"
            }
        ],
        "recognition": {
            "param": {
                "expected": "亚朵星球",
                "roi": [
                    172,
                    1481,
                    193,
                    120
                ]
            },
            "type": "OCR"
        }
    },
    "Atour-drawCard": {
        "action": {
            "param": {},
            "type": "Click"
        },
        "next": [
            "Atour-drawedCard"
        ],
        "recognition": {
            "param": {
                "expected": "抽",
                "roi": [
                    270,
                    729,
                    181,
                    185
                ]
            },
            "type": "OCR"
        }
    },
    "Atour-drawedCard": {
        "focus": {
            "Node.Recognition.Succeeded": "{name}获得额外奖励"
        },
        "next": [
            "stopAtour"
        ],
        "recognition": {
            "param": {
                "expected": "您获得一张",
                "roi": [
                    132,
                    556,
                    241,
                    140
                ]
            },
            "type": "OCR"
        }
    },
    "Atour-enterMainPage": {
        "action": {
            "param": {},
            "type": "Click"
        },
        "pre_delay": 1500,
        "recognition": {
            "param": {
                "expected": "首页",
                "roi": [
                    0,
                    1437,
                    179,
                    164
                ]
            },
            "type": "OCR"
        }
    },
    "Atour-enterSignPage": {
        "action": {
            "param": {},
            "type": "Click"
        },
        "next": [
            "Atour-signed",
            "Atour-sign"
        ],
        "on_error": [
            "Atour_retry"
        ],
        "recognition": {
            "param": {
                "expected": "签到",
                "roi": [
                    0,
                    929,
                    233,
                    247
                ]
            },
            "type": "OCR"
        }
    },
    "Atour-handleCaptcha": {
        "focus": {
            "Node.Recognition.Succeeded": "{name}触发验证码，需要手动完成"
        },
        "next": [
            "fullScreen_swipeUp"
        ],
        "recognition": {
            "param": {
                "template": [
                    "Atour/buttonReloadCaptcha.png"
                ]
            },
            "type": "TemplateMatch"
        }
    },
    "Atour-result_signSucceed": {
        "focus": {
            "Node.Action.Succeeded": "{name}签到成功"
        },
        "next": [
            "Atour-drawCard"
        ],
        "on_error": [
            "stopAtour"
        ],
        "post_delay": 0,
        "pre_delay": 0,
        "timeout": 5000
    },
    "Atour-sign": {
        "action": {
            "param": {},
            "type": "Click"
        },
        "next": [
            "Atour-result_signSucceed",
            "Atour-handleCaptcha"
        ],
        "recognition": {
            "param": {
                "expected": "立即签到",
                "roi": [
                    243,
                    465,
                    229,
                    145
                ]
            },
            "type": "OCR"
        },
        "timeout": 5000
    },
    "Atour-signed": {
        "next": [
            "Atour-result_signSucceed"
        ],
        "recognition": {
            "param": {
                "expected": "今日已签到",
                "roi": [
                    233,
                    462,
                    253,
                    146
                ]
            },
            "type": "OCR"
        }
    },
    "Atour_retry": {
        "next": [
            "Atour-confirmApp",
            {
                "jump_back": true,
                "name": "fullScreen_swipeBack"
            }
        ],
        "recognition": {
            "param": {
                "expected": [
                    "首页"
                ]
            },
            "type": "OCR"
        }
    },
    "startAtour": {
        "action": {
            "param": {
                "package": "com.atour.atourlife"
            },
            "type": "StartApp"
        }
    },
    "stopAtour": {
        "action": {
            "param": {
                "package": "com.atour.atourlife"
            },
            "type": "StopApp"
        }
    }
}