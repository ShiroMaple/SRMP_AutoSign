{
    "TestDemo_Entry": {
        "next": [
            "InitCheck"
        ]
    },
    "InitCheck": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "check_and_skip",
                "custom_action_param": {
                    "app_name": "测试应用"
                }
            }
        },
        "on_error": [
            "HandleInitError"
        ],
        "next": [
            "SimulateSignIn",
            "SkipTask"
        ]
    },
    "SkipTask": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "StopTask"
        }
    },
    "HandleInitError": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "update_task_status",
                "custom_action_param": {
                    "operation": "log_error",
                    "app_name": "测试应用",
                    "error_type": "初始化检查失败"
                }
            }
        },
        "next": [
            "SkipTask"
        ]
    },
    "SimulateSignIn": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    100,
                    200,
                    400,
                    100
                ],
                "expected": [
                    "签到成功"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    300,
                    400
                ]
            }
        },
        "on_error": [
            "HandleSignInError"
        ],
        "next": [
            "ExtractReward"
        ]
    },
    "HandleSignInError": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "update_task_status",
                "custom_action_param": {
                    "operation": "mark_failed",
                    "app_name": "测试应用"
                }
            }
        },
        "next": [
            "FinalReport"
        ]
    },
    "ExtractReward": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    150,
                    350,
                    300,
                    80
                ],
                "expected": "兑换码:.*"
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "extract_content",
                "custom_action_param": {
                    "app_name": "测试应用",
                    "content_type": "兑换码",
                    "content": "TEST-CODE-2024" // 测试用模拟值
                }
            }
        },
        "on_error": [
            "ContinueWithoutReward"
        ],
        "next": [
            "MarkSuccess"
        ]
    },
    "ContinueWithoutReward": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "MarkSuccess"
        ]
    },
    "MarkSuccess": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "update_task_status",
                "custom_action_param": {
                    "operation": "mark_success",
                    "app_name": "测试应用"
                }
            }
        }
    }
}