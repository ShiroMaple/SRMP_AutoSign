{ //缺少完成确认，会遗漏
    "Flyert": {
        "rate_limit": 1500,
        "next": [
            "Flyert-enterSignPage",
            "[JumpBack]startFlyert"
        ]
    },
    "Flyert-IgnoreUpdates": {},
    "Flyert-enterSignPage": {
        "pre_wait_freezes": 500,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "Flyert/SignButton.png",
                "roi": [
                    0,
                    14,
                    152,
                    156
                ]
            }
        },
        "action": "Click",
        "next": [
            "Flyert-checkSignSucceed",
            "Flyert-enterSignPage"
        ]
    },
    "Flyert-checkSignSucceed": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "签到成功",
                "roi": [
                    169,
                    468,
                    277,
                    179
                ]
            }
        },
        "next": [
            "Flyert-result_Succeed"
        ]
    },
    "Flyert-checkSigned": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "做任务赚威望",
                "roi": [
                    206,
                    672,
                    306,
                    148
                ]
            }
        },
        "next": [
            "Flyert-result_Succeed"
        ]
    },
    "Flyert-result_Succeed": {
        "pre_delay": 0,
        "post_delay": 0,
        "action": "DoNothing",
        "focus": {
            "Node.Action.Starting": "{name}签到成功"
        },
        "next": [
            "stopFlyert"
        ]
    },
    "startFlyert": {
        "action": "StartApp",
        "package": "com.ideal.flyerteacafes"
    },
    "stopFlyert": {
        "action": "StopApp",
        "package": "com.ideal.flyerteacafes"
    }
}