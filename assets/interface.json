{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "SRMP_AutoSign",
    "description": "自用基于框架回调的无侵入式自动签到系统。",
    "contact": "None",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 SRMP_AutoSign!",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/ShiroMaple/SRMP_AutoSign",
    "version": "0.0.1",
    // Mirror酱为第三方分发服务
    // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaXXX",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb"
            //"display_short_side": 1220 // 默认缩放分辨率的短边长度
        },
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "Visual Studio",
                // 截图及控制方式，请根据项目实际情况修改
                // 文档: https://maafw.xyz/docs/2.4-ControlMethods
                "screencap": "PrintWindow", // 截图方式
                "mouse": "PostMessageWithCursorPos", // 鼠标控制方式
                "keyboard": "PostMessageWithCursorPos" // 键盘控制方式
            }
        }
    ],
    "resource": [
        {
            "name": "默认资源",
            "path": [
                "./resource"
            ]
        },
        {
            "name": "备用资源",
            "path": [
                "./resource",
                "./resource_backup"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "./../agent/main.py"
            //"./../agent/callback_agent.py"
        ]
    },
    "task": [
        {
            "name": "普通任务",
            "entry": "MyTask1"
        },
        {
            "name": "森空岛",
            "entry": "entry_signSkland"
        },
        {
            "name": "测试应用",
            "entry": "DemoTask"
        },
        {
            "name": "推送通知",
            "entry": "NotifyReport"
        }
    ]
}